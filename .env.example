# --- Server configuration ---
# Path to the sample SQLite database (created by scripts/seed_db.py)
SAMPLE_DB_PATH=data/sample.db
# Folder with text files searched by the file_search tool
DOCS_DIR=data/docs
# Timeout (seconds) for the web_fetch tool
WEB_FETCH_TIMEOUT=15
# Maximum rows returned by sqlite_query
MAX_QUERY_ROWS=100

# --- Client configuration ---
# How the demo client reaches the MCP server.
# Option A (default, local): spawn the server over stdio
MCP_TRANSPORT=stdio
# Option B (docker-compose): connect to the server over Streamable HTTP
# MCP_TRANSPORT=http
# MCP_SERVER_URL=http://localhost:8000/mcp

# Port for the demo client web app
CLIENT_PORT=8080
